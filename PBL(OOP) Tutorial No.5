#include <iostream>                    // Header file for input and output
using namespace std;                   // Uses standard namespace

class Area                             // Defines a class named Area
{
public:                                // Public members of the class

    float area(float r)                // Function to calculate area of circle
    {
        return 3.14f * r * r;          // Returns area of circle (π × r × r)
    }                                  // Ends circle area function

    float area(float b, float h)       // Function to calculate area of triangle
    {
        return 0.5f * b * h;           // Returns area of triangle (½ × b × h)
    }                                  // Ends triangle area function

};                                     // Ends Area class

int main()                             // Main function starts
{
    Area a;                            // Creates an object of Area class

    float r, b, h;                     // Declares radius, base and height

    cout << "Enter radius of circle: "; // Asks user to enter radius
    cin >> r;                          // Takes radius from user

    cout << "Area of Circle = " << a.area(r) << endl;
    // Calls area(r) function and displays circle area

    cout << "Enter base and height of triangle: ";
    // Asks user to enter base and height

    cin >> b >> h;                     // Takes base and height from user

    cout << "Area of Triangle = " << a.area(b, h) << endl;
    // Calls area(b, h) function and displays triangle area

    return 0;                          // Returns 0 (successful execution)

}                                      // Ends main function
