#include <iostream>                    // Header file for input and output

int main() {                            // Main function starts

    int sum = 0;                        // Initializes sum with 0

    std::cout << "Even numbers between 1 and 50:\n";
    // Displays the heading

    for (int i = 1; i <= 50; i++) {     // Loop runs from 1 to 50

        if (i % 2 == 0) {               // Checks whether number is even

            std::cout << i << " ";      // Prints the even number

            sum += i;                  // Adds even number to sum
        }
    }                                  // Ends if and for loop

    std::cout << "\n\nThe sum of even numbers between 1 and 50 is: " << sum << std::endl;
    // Displays the total sum of even numbers

    return 0;                          // Returns 0 (successful execution)

}                                      // Ends main function
