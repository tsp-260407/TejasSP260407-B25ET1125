#include <iostream>                     // Header file for input and output
using namespace std;                    // Uses standard namespace

// Base class
class Vehicle                            // Defines base class Vehicle
{
public:                                  // Public members of the class

    virtual void showDetails()           // Declares a virtual function
    {
        cout << "This is a vehicle." << endl;
        // Displays vehicle message
    }
};                                       // Ends Vehicle class

// Derived class Car
class Car : public Vehicle               // Car inherits Vehicle class
{
public:                                  // Public members of Car class

    void showDetails()                   // Overrides base class function
    {
        cout << "This is a Car." << endl;
        // Displays car message
    }
};                                       // Ends Car class

// Derived class Bike
class Bike : public Vehicle              // Bike inherits Vehicle class
{
public:                                  // Public members of Bike class

    void showDetails()                   // Overrides base class function
    {
        cout << "This is a Bike." << endl;
        // Displays bike message
    }
};                                       // Ends Bike class

int main()                               // Main function starts
{
    Vehicle *v;                          // Declares a base class pointer

    Car c;                               // Creates an object of Car class

    v = &c;                              // Stores address of Car object in pointer

    v->showDetails();                    // Calls Car's function using virtual function

    Bike b;                              // Creates an object of Bike class

    v = &b;                              // Stores address of Bike object in pointer

    v->showDetails();                    // Calls Bike's function using virtual function

    return 0;                            // Returns 0 (successful execution)
}                                        // Ends main function
