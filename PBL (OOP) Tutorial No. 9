#include <iostream>
using namespace std;

// Base class
class Vehicle
{
public:
    // Virtual function
    virtual void showDetails()
    {
        cout << "This is a vehicle." << endl;
    }
};
// Derived class Car
class Car : public Vehicle
{
public:
    // Function overriding
    void showDetails()
    {
        cout << "This is a Car." << endl;
    }
};
// Derived class Bike
class Bike : public Vehicle
{
public:
    // Function overriding
    void showDetails()
    {
        cout << "This is a Bike." << endl;
    }
};
int main()
{
    // Base class pointer
    Vehicle *v;

    // Create Car object
    Car c;

    // Store address of Car object in Vehicle pointer
    v = &c;

    // Calls Car's showDetails() due to virtual function
    v->showDetails();

    // Create Bike object
    Bike b;

    // Store address of Bike object in Vehicle pointer
    v = &b;

    // Calls Bike's showDetails() due to virtual function
    v->showDetails();

    return 0;
}
