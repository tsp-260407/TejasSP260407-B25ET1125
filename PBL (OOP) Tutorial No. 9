#include <iostream>
using namespace std;

class Vehicle {
public:
    virtual void showDetails() {
        cout << "This is a vehicle." << endl;
    }
};
class Car : public Vehicle {
public:
    void showDetails() {
        cout << "This is a Car." << endl;
    }
};
class Bike : public Vehicle {
public:
    void showDetails() {
        cout << "This is a Bike." << endl;
    }
};
int main() {
    Vehicle *v;
    Car c;
    v = &c;
    v->showDetails();
    Bike b;
    v = &b;
    v->showDetails();
    return 0;
}
