#include <iostream>
using namespace std;

// Base class 1: Employee
class Employee
{
protected:
    int id;
    string name;

public:
    // Function to get employee details
    void getEmployee()
    {
        cout << "Enter ID and Name: ";
        cin >> id >> name;
    }
};

// Base class 2: Attendance
class Attendance
{
protected:
    int total, present;

public:
    // Function to get attendance details
    void getAttendance()
    {
        cout << "Enter Total Days and Present Days: ";
        cin >> total >> present;
    }
};

// Derived class
// Inheriting from both Employee and Attendance
class EmployeeDetails : public Employee, public Attendance
{
public:
    // Function to display employee and attendance details
    void display()
    {
        // Calculate attendance percentage
        float percentage = (present * 100.0) / total;

        // Display employee details
        cout << "\nEmployee ID: " << id;
        cout << "\nName: " << name;

        // Display attendance percentage
        cout << "\nAttendance: " << percentage << "%";
    }
};

int main()
{
    // Create object of derived class
    EmployeeDetails e;

    // Get employee details
    e.getEmployee();

    // Get attendance details
    e.getAttendance();

    // Display all details
    e.display();

    return 0;
}
