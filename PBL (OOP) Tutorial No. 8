#include <iostream>                     // Header file for input and output
using namespace std;                    // Uses standard namespace

// Base class 1: Employee                 // First base class
class Employee                           // Defines Employee class
{
protected:                               // Members accessible in derived class
    int id;                              // Declares employee ID
    string name;                         // Declares employee name

public:                                  // Public members of the class

    void getEmployee()                   // Function to get employee details
    {
        cout << "Enter ID and Name: ";   // Asks user to enter ID and name
        cin >> id >> name;               // Takes ID and name from user
    }                                    // Ends getEmployee function
};                                       // Ends Employee class

// Base class 2: Attendance               // Second base class
class Attendance                         // Defines Attendance class
{
protected:                               // Members accessible in derived class
    int total, present;                  // Declares total and present days

public:                                  // Public members of the class

    void getAttendance()                 // Function to get attendance details
    {
        cout << "Enter Total Days and Present Days: ";
        // Asks user to enter total and present days

        cin >> total >> present;         // Takes attendance details from user
    }                                    // Ends getAttendance function
};                                       // Ends Attendance class

// Derived class                          // Class that inherits two base classes
class EmployeeDetails : public Employee, public Attendance
// Inherits Employee and Attendance classes using multiple inheritance
{
public:                                  // Public members of derived class

    void display()                       // Function to display details
    {
        float percentage = (present * 100.0) / total;
        // Calculates attendance percentage

        cout << "\nEmployee ID: " << id;
        // Displays employee ID

        cout << "\nName: " << name;      // Displays employee name

        cout << "\nAttendance: " << percentage << "%";
        // Displays attendance percentage
    }                                    // Ends display function
};                                       // Ends EmployeeDetails class

int main()                               // Main function starts
{
    EmployeeDetails e;                   // Creates object of derived class

    e.getEmployee();                     // Calls employee details function

    e.getAttendance();                   // Calls attendance details function

    e.display();                         // Calls display function

    return 0;                            // Returns 0 (successful execution)
}                                        // Ends main function
